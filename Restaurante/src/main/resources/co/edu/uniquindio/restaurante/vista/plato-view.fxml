<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.restaurante.controlador.PlatoController">
    <padding>
        <Insets top="28" right="32" bottom="28" left="32"/>
    </padding>

    <HBox alignment="CENTER_LEFT">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Platos del menú" styleClass="titulo"/>
            <Label text="Administre los platos, sus precios y disponibilidad." styleClass="subtitulo"/>
        </VBox>
        <Button fx:id="btnNuevo" text="+ Nuevo plato" styleClass="boton-primario" onAction="#onNuevo"/>
    </HBox>

    <Label fx:id="lblMensaje" style="-fx-text-fill: -color-exito; -fx-font-weight: 600;"/>

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- Listado -->
        <VBox spacing="12" styleClass="panel" HBox.hgrow="ALWAYS">
            <Label text="Menú del restaurante" style="-fx-font-size: 18px; -fx-font-weight: 600;"/>
            <TextField fx:id="txtBuscar" promptText="Buscar por nombre o categoría" styleClass="campo"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="lblSeleccion" styleClass="subtitulo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="btnEditar" text="Editar" styleClass="boton-secundario" onAction="#onEditar"/>
                <Button fx:id="btnEliminar" text="Eliminar" styleClass="boton-peligro" onAction="#onEliminar"/>
            </HBox>
            <TableView fx:id="tblPlatos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50" maxWidth="60"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200"/>
                    <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="120"/>
                    <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="130"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="lblPaginacion" styleClass="subtitulo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="btnAnterior" text="Anterior" styleClass="boton-secundario" onAction="#onAnterior"/>
                <Button fx:id="btnSiguiente" text="Siguiente" styleClass="boton-secundario" onAction="#onSiguiente"/>
            </HBox>
        </VBox>

        <!-- Formulario -->
        <VBox spacing="6" styleClass="panel" prefWidth="330" minWidth="330" maxWidth="330">
            <Label fx:id="lblTituloForm" text="Nuevo plato" style="-fx-font-size: 18px; -fx-font-weight: 600;"/>
            <Label text="Complete los datos del plato." styleClass="subtitulo"/>

            <Label text="Nombre *" styleClass="etiqueta" style="-fx-padding: 10 0 0 0;"/>
            <TextField fx:id="txtNombre" promptText="Nombre del plato" styleClass="campo"/>
            <Label fx:id="lblErrorNombre" styleClass="mensaje-error"/>

            <Label text="Categoría *" styleClass="etiqueta" style="-fx-padding: 6 0 0 0;"/>
            <ComboBox fx:id="cmbCategoria" promptText="Seleccione..." maxWidth="Infinity"/>
            <Label fx:id="lblErrorCategoria" styleClass="mensaje-error"/>

            <Label text="Precio *" styleClass="etiqueta" style="-fx-padding: 6 0 0 0;"/>
            <TextField fx:id="txtPrecio" promptText="Ej: 28000" styleClass="campo"/>
            <Label fx:id="lblErrorPrecio" styleClass="mensaje-error"/>

            <CheckBox fx:id="chkDisponible" text="Disponible (visible al realizar un pedido)"
                      selected="true" style="-fx-padding: 10 0 0 0;"/>

            <Label text="* Campos obligatorios" styleClass="subtitulo" style="-fx-padding: 12 0 0 0;"/>
            <HBox spacing="10" style="-fx-padding: 6 0 0 0;">
                <Button fx:id="btnGuardar" text="Guardar plato" styleClass="boton-primario"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onGuardar"/>
                <Button text="Cancelar" styleClass="boton-secundario" onAction="#onCancelar"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>