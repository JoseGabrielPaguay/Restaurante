<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.restaurante.controlador.PedidoController">
    <padding>
        <Insets top="28" right="32" bottom="28" left="32"/>
    </padding>

    <Label text="PEDIDOS / NUEVA COMANDA" styleClass="subtitulo"/>
    <Label text="Realizar pedido" styleClass="titulo"/>
    <HBox spacing="10">
        <Label fx:id="lblIdPedido" style="-fx-background-color: #F0EBE3; -fx-background-radius: 8; -fx-padding: 5 12;"/>
        <Label fx:id="lblFechaHora" style="-fx-background-color: #F0EBE3; -fx-background-radius: 8; -fx-padding: 5 12;"/>
    </HBox>
    <Label fx:id="lblBanner" styleClass="banner-error" maxWidth="Infinity"/>

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- Datos del pedido -->
        <VBox spacing="8" styleClass="panel" HBox.hgrow="ALWAYS">
            <Label text="Datos del pedido" style="-fx-font-size: 18px; -fx-font-weight: 600;"/>
            <HBox spacing="14">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Mesa *" styleClass="etiqueta"/>
                    <ComboBox fx:id="cmbMesa" promptText="Seleccione..." maxWidth="Infinity"/>
                    <Label fx:id="lblErrorMesa" styleClass="mensaje-error"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Mesero *" styleClass="etiqueta"/>
                    <ComboBox fx:id="cmbMesero" promptText="Seleccione..." maxWidth="Infinity"/>
                    <Label fx:id="lblErrorMesero" styleClass="mensaje-error"/>
                </VBox>
            </HBox>

            <TextField fx:id="txtBuscarPlato" promptText="Buscar plato" styleClass="campo"/>
            <HBox fx:id="hboxCategorias" spacing="8"/>

            <TableView fx:id="tblPlatosMenu" VBox.vgrow="ALWAYS" prefHeight="260">
                <columns>
                    <TableColumn fx:id="colMenuNombre" text="Plato" prefWidth="190"/>
                    <TableColumn fx:id="colMenuCategoria" text="Categoría" prefWidth="110"/>
                    <TableColumn fx:id="colMenuPrecio" text="Precio" prefWidth="90"/>
                    <TableColumn fx:id="colMenuEstado" text="Estado" prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            <Label fx:id="lblErrorPlato" styleClass="mensaje-error"/>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Cantidad" styleClass="etiqueta"/>
                <Spinner fx:id="spnCantidad" editable="true" prefWidth="110"/>
                <Button fx:id="btnAgregarPlato" text="Agregar a la comanda" styleClass="boton-primario"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onAgregarItem"/>
            </HBox>
            <Label fx:id="lblErrorCantidad" styleClass="mensaje-error"/>
        </VBox>

        <!-- Comanda -->
        <VBox spacing="8" styleClass="panel" prefWidth="400" minWidth="400" maxWidth="400">
            <Label text="Comanda" style="-fx-font-size: 18px; -fx-font-weight: 600;"/>
            <Label text="RESUMEN DEL PEDIDO" styleClass="subtitulo"/>

            <Label text="Cliente (opcional)" styleClass="etiqueta"/>
            <TextField fx:id="txtNombreCliente" promptText="Nombre del cliente" styleClass="campo"/>
            <Label text="Observaciones" styleClass="etiqueta"/>
            <TextField fx:id="txtObservaciones" promptText="Indicaciones para cocina (alergias, restricciones)"
                       styleClass="campo"/>

            <TableView fx:id="tblItemsPedido" VBox.vgrow="ALWAYS" prefHeight="200">
                <columns>
                    <TableColumn fx:id="colItemPlato" text="Plato" prefWidth="220"/>
                    <TableColumn fx:id="colItemImporte" text="Importe" prefWidth="110"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            <Label fx:id="lblErrorOrden" styleClass="mensaje-error"/>
            <Button fx:id="btnQuitarPlato" text="Quitar plato" styleClass="boton-secundario" onAction="#onQuitarItem"/>

            <HBox alignment="CENTER_LEFT" style="-fx-padding: 8 0 0 0;">
                <Label text="Total" style="-fx-font-size: 16px; -fx-font-weight: 600;" HBox.hgrow="ALWAYS"
                       maxWidth="Infinity"/>
                <Label fx:id="lblTotal" styleClass="total"/>
            </HBox>
            <Label text="Revise la comanda antes de enviarla." styleClass="subtitulo"/>
            <HBox spacing="10">
                <Button fx:id="btnCancelar" text="Cancelar" styleClass="boton-secundario" onAction="#onCancelar"/>
                <Button fx:id="btnEnviarACocina" text="Enviar a cocina" styleClass="boton-primario"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onEnviarACocina"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>